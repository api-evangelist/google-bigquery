{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google BigQuery Datasets Projects API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Google BigQuery List projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bigquery.googleapis.com/bigquery/v2/projects",
            "params": [
              {
                "name": "maxResults",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Page token for pagination"
              }
            ]
          },
          "docs": "Lists all projects to which the user has been granted any project role."
        }
      ]
    }
  ],
  "bundled": true
}